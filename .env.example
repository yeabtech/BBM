# Localhost mode is the default. For Wi-Fi/hotspot hosting set LAN_ENABLED=true
# and optionally HOST=0.0.0.0, then restart the server.
HOST=127.0.0.1
PORT=3000
LAN_ENABLED=false
# Optional: directory of a built client (e.g. apps/client/dist) to serve from this
# server on the same port, so other devices need no separate Vite client.
# CLIENT_DIST=apps/client/dist
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/bbm
DATABASE_REQUIRED=false
VITE_API_BASE_URL=http://127.0.0.1:3000
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
ROOM_IDLE_MINUTES=30
HOST_GRACE_SECONDS=30
ROOM_SWEEP_SECONDS=5
RACE_COUNTDOWN_SECONDS=3
RACE_TIMEOUT_SECONDS=120
RACE_TICK_MS=50
TRUST_PROXY=false
